#!/usr/bin/env python3
"""
Universal CTF web recon script.
Prompts for the target, flag format, paths, and auth details, then checks
every path for flags in the body, headers, and SQLite databases.

Only run this against targets you are authorized to test.
"""
import os
import re
import sqlite3
import ssl
import urllib.error
import urllib.request

SQLITE_MAGIC = b"SQLite format 3\x00"
DEFAULT_PUBLIC_PATHS = [
    "/robots.txt", "/sitemap.xml", "/.env", "/.git/config",
    "/users.bak", "/backup.zip", "/config.bak",
    "/static/app.js", "/static/api.js",
]
MAX_PRINT_ROWS = 100

found_flags = {}  # flag -> where it was found


# ---------- input helpers ----------

def ask(prompt, default=None, required=False):
    """Prompt for a value. Returns default if the user presses Enter."""
    suffix = f" [{default}]" if default else ""
    while True:
        value = input(f"{prompt}{suffix}: ").strip()
        if value:
            return value
        if default is not None:
            return default
        if not required:
            return ""
        print("  This field is required.")


def ask_yes_no(prompt, default=False):
    hint = "Y/n" if default else "y/N"
    value = input(f"{prompt} [{hint}]: ").strip().lower()
    if not value:
        return default
    return value.startswith("y")


def parse_list(text):
    return [item.strip() for item in text.split(",") if item.strip()]


def parse_headers(text):
    """Parse 'Name: Value, Name2: Value2' into a dict."""
    headers = {}
    for item in parse_list(text):
        if ":" in item:
            name, value = item.split(":", 1)
            headers[name.strip()] = value.strip()
        else:
            print(f"  [!] Ignoring malformed header: {item}")
    return headers


def normalize_path(path):
    path = path.strip()
    return path if path.startswith("/") else "/" + path


# ---------- networking ----------

def fetch(base, path, headers, ssl_ctx):
    """Return (status, headers, body) or (None, None, None) on connection failure."""
    req = urllib.request.Request(base + path, headers=headers)
    try:
        with urllib.request.urlopen(req, context=ssl_ctx, timeout=15) as resp:
            return resp.status, resp.headers, resp.read()
    except urllib.error.HTTPError as e:
        # 4xx/5xx responses can still contain useful data
        return e.code, e.headers, e.read()
    except (urllib.error.URLError, OSError) as e:
        print(f"  [!] Request failed: {getattr(e, 'reason', e)}")
        return None, None, None


# ---------- flag handling ----------

def record(flag, source):
    if flag not in found_flags:
        found_flags[flag] = source
        print(f"  [+] FLAG FOUND: {flag}   (from {source})")


def scan_text(text, source, flag_re, keyword_re):
    for match in flag_re.finditer(text):
        record(match.group(0), source)
    # Show lines that mention "flag" so comments and hints are visible
    hits = [line.strip() for line in text.splitlines() if keyword_re.search(line)]
    for line in hits[:20]:
        print(f"    > {line[:200]}")


def dump_sqlite(file_path, source, flag_re):
    """Open a SQLite file read-only, print every table, and scan rows for flags."""
    con = sqlite3.connect(f"file:{os.path.abspath(file_path)}?mode=ro", uri=True)
    try:
        tables = [row[0] for row in con.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")]
        print(f"  SQLite database with {len(tables)} table(s)")
        for table in tables:
            cur = con.execute(f'SELECT * FROM "{table}"')
            cols = [d[0] for d in cur.description]
            print(f"\n  -- table: {table}")
            print("     " + " | ".join(cols))
            for i, row in enumerate(cur):
                line = " | ".join("" if v is None else str(v) for v in row)
                for match in flag_re.finditer(line):
                    record(match.group(0), f"{source} table {table}")
                if i < MAX_PRINT_ROWS:
                    print(f"     {line}")
            if i >= MAX_PRINT_ROWS:
                print(f"     ... (showing first {MAX_PRINT_ROWS} rows, all rows were scanned)")
    finally:
        con.close()


def safe_filename(path):
    name = re.sub(r"[^A-Za-z0-9._-]", "_", path.strip("/"))
    return name or "root"


# ---------- main analysis ----------

def analyze(base, path, headers, cfg):
    print(f"\n[*] {path}")
    status, resp_headers, body = fetch(base, path, headers, cfg["ssl_ctx"])
    if status is None:
        return
    print(f"  Status: {status}")

    # Response headers can hold flags too
    for name, value in resp_headers.items():
        if "flag" in name.lower() or cfg["flag_re"].search(value):
            print(f"  Header {name}: {value}")
        for match in cfg["flag_re"].finditer(f"{name}: {value}"):
            record(match.group(0), f"header {name} on {path}")

    if not body:
        return

    file_path = os.path.join(cfg["out_dir"], safe_filename(path))
    with open(file_path, "wb") as f:
        f.write(body)

    source = f"{path}"
    if body.startswith(SQLITE_MAGIC):
        dump_sqlite(file_path, source, cfg["flag_re"])
    else:
        text = body.decode("utf-8", errors="ignore")
        scan_text(text, source, cfg["flag_re"], cfg["keyword_re"])


def build_flag_regex(prefix):
    """Build a regex for flags like 'flag{...}' or 'CTF-...'."""
    if prefix.endswith("{"):
        return re.compile(re.escape(prefix) + r"[^\s}]+\}")
    return re.compile(re.escape(prefix) + r"\S+")


def main():
    print("=== Universal CTF Web Recon ===")
    print("Only run this against targets you are authorized to test.\n")

    # Target
    base = ask("Target base URL (e.g. https://host:8000)", required=True).rstrip("/")
    if not base.startswith(("http://", "https://")):
        base = "http://" + base

    # Flag format
    prefix = ask("Flag format prefix (e.g. flag{ or CTF{ or picoCTF{)", default="flag{")
    flag_re = build_flag_regex(prefix)
    keyword_re = re.compile(r"flag", re.IGNORECASE)

    # Paths
    public_input = ask("Public paths to check (comma-separated, Enter for defaults)")
    public_paths = [normalize_path(p) for p in parse_list(public_input)] or DEFAULT_PUBLIC_PATHS

    auth_input = ask("Authenticated paths to check (comma-separated, Enter to skip)")
    auth_paths = [normalize_path(p) for p in parse_list(auth_input)]

    # Auth
    base_headers = {"User-Agent": "Mozilla/5.0"}
    auth_headers = dict(base_headers)

    if auth_paths:
        cookie = ask("Session cookie (e.g. session=abc123, Enter if none)")
        if cookie:
            auth_headers["Cookie"] = cookie

        api_name = ask("API key header name (e.g. API-Key, Authorization, Enter if none)")
        if api_name:
            api_value = ask(f"Value for {api_name}", required=True)
            auth_headers[api_name] = api_value

        extra = ask("Extra headers as Name: Value, comma-separated (Enter if none)")
        auth_headers.update(parse_headers(extra))

    # Options
    out_dir = ask("Output folder for downloaded files", default="ctf_output")
    os.makedirs(out_dir, exist_ok=True)

    ssl_ctx = None
    if ask_yes_no("Ignore SSL certificate errors? (for self-signed certs)", default=False):
        ssl_ctx = ssl.create_default_context()
        ssl_ctx.check_hostname = False
        ssl_ctx.verify_mode = ssl.CERT_NONE

    cfg = {
        "flag_re": flag_re,
        "keyword_re": keyword_re,
        "out_dir": out_dir,
        "ssl_ctx": ssl_ctx,
    }

    print("\n--- Checking public paths ---")
    for path in public_paths:
        analyze(base, path, base_headers, cfg)

    if auth_paths:
        print("\n--- Checking authenticated paths ---")
        for path in auth_paths:
            analyze(base, path, auth_headers, cfg)

    # Summary
    print("\n=== Summary ===")
    if found_flags:
        for flag, source in found_flags.items():
            print(f"{flag}   (from {source})")
    else:
        print("No flags found. Try other paths, check the output folder manually, "
              "or verify the flag format prefix.")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nStopped by user.")
